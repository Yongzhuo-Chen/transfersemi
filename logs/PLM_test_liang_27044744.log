            bandwidth_scale = bandwidth_scale, method = method)
        hessian[[index]] <- get_hessian_nonpar_gradient(X[split_index == 
            index], grid, bandwidth_scale = bandwidth_scale)
    }
    return(list(hessian = hessian, gradient = gradient))
}

