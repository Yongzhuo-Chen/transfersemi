function (X, D, Y, effect, target_indx = 1, method = "CATE") 
{
    ntask <- length(X)
    if (method == "CATE") {
        X_list <- lapply(X[-target_indx], function(x) as.matrix(x))
    }
    else {
        X_list <- lapply(D[-target_indx], function(d) matrix(d, 
            ncol = 1))
    }
    Z_list <- X[-target_indx]
    y_list <- lapply(Y[-target_indx], function(y) matrix(y, ncol = 1))
    if (method == "CATE") {
        X0 <- as.matrix(X[[target_indx]])
    }
    else {
        X0 <- matrix(D[[target_indx]], ncol = 1)
    }
    Z0 <- X[[target_indx]]
    y0 <- matrix(Y[[target_indx]], ncol = 1)
    list(X_list = X_list, Z_list = Z_list, y_list = y_list, X0 = X0, 
        Z0 = Z0, y0 = y0, beta0 = effect[[target_indx]])
}

