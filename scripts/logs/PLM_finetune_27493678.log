function (models, X_test_list, task_id, link = "linear") 
{
    spline_funs <- models$spline_funs
    Theta <- matrix(models$vanilla[task_id, , 1, drop = FALSE])
    Xs_test <- NULL
    X_task <- X_test_list[[task_id]]
    for (j in 1:ncol(X_task)) {
        if (is.null(spline_funs)) {
            Xs_j <- X_task[, j, drop = FALSE]
        }
        else {
            Xs_j <- spline_funs[[j]](X_task[, j])
        }
        Xs_test <- cbind(Xs_test, Xs_j)
    }
    z <- Xs_test %*% Theta
    if (link == "linear") 
        return(z)
    if (link == "logistic") 
        return(1/(1 + exp(-z)))
}

