library(dplyr)
data_melted <- dcast(df, model ~ Variable, value.var = "Correlation")
rownames(data_melted) <- data_melted$model
data_matrix <- as.matrix(data_melted[,-1])
heatmap_data_con <- reshape2::melt(data_matrix)
rank_order <- heatmap_data_con %>%
filter(Var1 == "semipara_transfer_tuned") %>%
arrange(desc(value)) %>%
pull(Var2)
# Reorder data based on the rank order
heatmap_data_con$Var2 <- factor(heatmap_data_con$Var2, levels = rank_order)
ggplot(heatmap_data_con, aes(Var2, Var1, fill = value)) +
geom_tile() +
geom_text(aes(label = round(value, 3)), color = "black", size=2) +
scale_fill_gradient2(low = "blue", high = "red", mid = "white", midpoint = 0) +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
axis.text.y = element_text(face = "bold"),
legend.title = element_text(size = 10)
)+
labs(x = "Variable", y = "Model", fill = "Correlation")
