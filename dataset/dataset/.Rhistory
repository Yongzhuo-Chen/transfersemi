data_melted <- dcast(df, model ~ Variable, value.var = "Correlation")
rownames(data_melted) <- data_melted$model
data_matrix <- as.matrix(data_melted[,-1])
heatmap_data <- reshape2::melt(data_matrix)
heatmap_data2 <- rbind(heatmap_data, heatmap_data_con)
library(forcats)  # only for the safety check below; base R works too
## ---------------- Var1 ----------------
# Named vector:  names = old levels, values = new labels
v1_map <- c(
no_transfer            = "Baseline",
para_transfer_tuned    = "Late Fusion",
Sai_transfer           = "Oracle Transfer-Lasso",
semipara_transfer_tuned= "Late Fusion with Nuisance"
)
# Safety check: every level must be present in the map
stopifnot(setequal(levels(heatmap_data2$Var1), names(v1_map)))
# Apply the map (order is preserved because we index by current level names)
levels(heatmap_data2$Var1) <- v1_map[levels(heatmap_data2$Var1)]
## ---------------- Var2 ----------------
v2_map <- c(
age_categoryAbove_55   = "Age > 55",
age_categoryBelow_55   = "Age ≤ 55",
docnursespoken2years   = "Been told having a mammogram",
racecauc               = "Race",
workpay                = "Working for pay",
yearmamsum0            = "Never had mammogram",
yearmamsum1            = "Had 1 year of mammogram",
yearmamsum2            = "Had 2 years of mammogram",
yearmamsum3            = "Had 3 years of mammogram",
yearmamsum4            = "Had 4 years of mammogram",
ben1tot                = "Benefits scale",
fatal1tot              = "Fatalism scale",
fear1tot               = "Fear scale",
know1tot               = "Knowledge scale",
se1tot                 = "Self-efficacy scale",
sus1tot                = "Susceptibility scale"
)
stopifnot(setequal(levels(heatmap_data2$Var2), names(v2_map)))
levels(heatmap_data2$Var2) <- v2_map[levels(heatmap_data2$Var2)]
rank_order <- heatmap_data2 %>%
filter(Var1 == "Late Fusion with Nuisance") %>%
arrange(desc(value)) %>%
pull(Var2)
# Reorder data based on the rank order
heatmap_data2$Var2 <- factor(heatmap_data2$Var2, levels = rank_order)
heatmap_data2$Var1 <- factor(heatmap_data2$Var1, levels = rev(levels(heatmap_data2$Var1)))
p<-ggplot(heatmap_data2, aes(Var2, Var1, fill = value)) +
geom_tile() +
#geom_text(aes(label = round(value, 3)), color = "black", size=2) +
scale_fill_gradient2(low = "blue", high = "red", mid = "white", midpoint = 0) +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
axis.text.y = element_text(face = "bold"),
legend.title = element_text(size = 10)
)+
labs(x = "Variable", y = "Methods", fill = "Correlation")
