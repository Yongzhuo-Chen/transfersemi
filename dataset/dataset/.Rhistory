selected_columns <- X[[index]][, continuous_vars, drop = FALSE]
correlations <- sapply(1:ncol(selected_columns), function(i) cor(selected_columns[, i], target, method = "pearson"))
names(correlations) <- continuous_vars
n_task <- index
# Create a data frame
final_df <- data.frame(
Variable = names(correlations),
Correlation = correlations,
n_task = n_task,
model = model,
stringsAsFactors = FALSE # Ensures string variables remain as character type
)
all_dfs[[model]][[index]] <- final_df
}
}
all_dfs_flattened <- do.call(c, all_dfs)
combined_df <- do.call(rbind, all_dfs_flattened)
print(combined_df)
library(ggplot2)
library(reshape2)
df = aggregate(Correlation ~ model + Variable, data = combined_df, FUN = function(x) c(mean = mean(x)))
df = do.call(data.frame, df)
ggplot(df, aes(x = Variable, y = Correlation, group = interaction(model),
color = model)) +
geom_line( size = 1) +
geom_point(size = 3) +
labs(
x = "Variable",
y = "Correlation",
#color = "n_task",
linetype = "Model"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))  # Rotate x-axis labels
ggplot(df, aes(x = Variable, y = Correlation, group = model, color = model)) +
geom_line(size = 1.2) +
geom_point(size = 3) +
facet_wrap(~model, scales = "free_y") +
labs(
x = "Variable",
y = "Correlation",
color = "Model"
) +
theme_bw(base_size = 14) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "none"
)
